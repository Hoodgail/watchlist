NODE_ENV=development
PORT=3201
DATABASE_URL=postgresql://postgres:password@localhost:5432/watchlist
# Replace both placeholders with different random values (openssl rand -hex 32).
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3200
FRONTEND_URL=http://localhost:3200
TMDB_API_KEY=
RAWG_API_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3201/api/auth/oauth/discord/callback
# Recovery is unavailable (503) until both SMTP settings are set.
SMTP_URL=
SMTP_FROM=
# Comma-separated user UUIDs authorized to change global catalog aliases.
CATALOG_EDITOR_IDS=
