{
  "name": "@hoodgail/watchlist-backend",
  "private": true,
  "author": "Hoodgail Benjamin",
  "url": "https://watchlist.hoodgail.me",
  "version": "1.0.0",
  "description": "Backend API for watchlist application",
  "type": "module",
  "main": "dist/backend/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "typecheck": "tsc --noEmit",
    "start": "node dist/backend/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test:providers": "node --import tsx scripts/check-providers.ts",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@consumet/extensions": "^1.8.8",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.5",
    "@prisma/adapter-pg": "^7.10.0",
    "pg": "^8.23.0",
    "cheerio": "^1.2.0",
    "nodemailer": "^10.0.10",
    "prisma": "^7.10.0",
    "ipaddr.js": "^2.5.0",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "@types/pg": "^8.23.1",
    "@types/nodemailer": "^8.0.2"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "prisma": {
      "mysql2": "^3.24.4"
    }
  }
}
