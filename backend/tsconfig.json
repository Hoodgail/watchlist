{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "outDir": "./dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@shared/*": [
        "../shared/*"
      ],
      "ipaddr.js": [
        "./node_modules/ipaddr.js/lib/ipaddr.d.ts"
      ],
      "undici": [
        "./node_modules/undici/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "../shared/**/*",
    "../server/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/tests"
  ]
}
