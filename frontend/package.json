{
  "name": "@hoodgail/watchlist-frontend",
  "private": true,
  "version": "1.0.0",
  "author": "Hoodgail Benjamin",
  "url": "https://watchlist.hoodgail.me",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "dev:vite": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "start": "NODE_ENV=production node dist/server.js",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "hls.js": "^1.7.3",
    "m3u8-parser": "^7.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.4",
    "ipaddr.js": "^2.5.0",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/m3u8-parser": "^7.2.6",
    "@playwright/test": "^1.63.0",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
